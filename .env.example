# Reference only: the app reads process environment variables, not this file automatically.
# Local browser workspace mode needs none of these settings.
COURSE_QUIZ_CLOUD=1
COURSE_QUIZ_PUBLIC_ORIGIN=https://your-app.onrender.com
COURSE_QUIZ_SECRET=generate-a-random-value-with-at-least-32-characters

# Optional email accounts: copy from YOUR Firebase web-app configuration.
# Never put a Firebase service account key or a model API Key here.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
